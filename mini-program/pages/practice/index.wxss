page {
  background: #f7f7f7;
}

.practice-page {
  min-height: 100vh;
  padding-bottom: 132rpx;
  box-sizing: border-box;
}

.practice-header {
  padding: 28rpx 32rpx 20rpx;
  background: #fff;
  border-bottom: 1rpx solid #eee;
}

.practice-title {
  color: #222;
  font-size: 30rpx;
  font-weight: 800;
}

.practice-topic {
  color: #ff3f4d;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.message-list {
  height: calc(100vh - 252rpx);
  padding: 24rpx 28rpx;
  box-sizing: border-box;
}

.message {
  margin-bottom: 24rpx;
}

.mine {
  text-align: right;
}

.speaker {
  color: #7a7a7a;
  font-size: 22rpx;
  margin-bottom: 8rpx;
}

.bubble {
  display: inline-block;
  max-width: 78%;
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  color: #333;
  font-size: 28rpx;
  line-height: 1.5;
  text-align: left;
}

.assistant .bubble {
  background: #fff;
}

.mine .bubble {
  background: linear-gradient(90deg, #ff1717, #ff6b00);
  color: #fff;
}

.score {
  display: inline-block;
  margin-top: 8rpx;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
  background: #fff2f0;
  color: #ff3f4d;
  font-size: 22rpx;
}

.typing {
  color: #999;
  font-size: 24rpx;
  padding: 12rpx 0;
}

.text-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  min-height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 16rpx 20rpx 24rpx;
  box-sizing: border-box;
}

.text-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 0 24rpx;
  color: #333;
  font-size: 26rpx;
  box-sizing: border-box;
}

.send-btn,
.finish-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  color: #fff;
  font-size: 26rpx;
}

.send-btn {
  width: 112rpx;
  background: linear-gradient(90deg, #ff1515, #ff6b00);
  font-weight: 800;
}

.finish-btn {
  width: 96rpx;
  background: #444;
}
