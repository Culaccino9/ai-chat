<view class="container"><view class="card"><view class="title">练习房间</view><view class="muted">实时文字陪练，大模型会分析你的回答并给出提示</view></view><scroll-view scroll-y style="height:760rpx"><block wx:for="{{messages}}" wx:key="idx"><view class="card"><view style="font-weight:700">{{item.speaker}}</view><view>{{item.content}}</view><view wx:if="{{item.quality}}" class="muted">得分：{{item.quality.score}}｜等级：{{item.quality.level}}</view></view></block></scroll-view><view class="card"><input placeholder="请输入你的回答" value="{{input}}" bindinput="onInput" /><button class="btn" bindtap="send">发送</button><button bindtap="finish">结束并生成报告</button></view></view>
