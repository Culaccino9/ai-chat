<view class="coach-page">
  <view class="hero">
    <view class="nav-title">智能陪练</view>
    <view class="greeting">
      <view class="bot">
        <view class="bot-face">
          <view class="bot-eye"></view>
          <view class="bot-smile"></view>
          <view class="bot-eye"></view>
        </view>
      </view>
      <text>Hi，我可以帮助你训练话术！</text>
    </view>
  </view>

  <view class="scenario-list">
    <block wx:for="{{items}}" wx:key="id">
      <view class="scenario-card" bindtap="open" data-id="{{item.id}}" data-title="{{item.title}}">
        <view class="scenario-title">{{item.title}}</view>
        <view class="scenario-meta">
          <text class="people-icon">♙</text>
          <text>{{item.practiceCount || 0}}次陪练</text>
        </view>
      </view>
    </block>
  </view>
</view>
