page {
  background: #fff;
}

.detail-page {
  min-height: 100vh;
  padding-bottom: 140rpx;
  box-sizing: border-box;
}

.top-line {
  height: 88rpx;
  padding: 0 28rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #333;
  font-size: 28rpx;
}

.history {
  color: #333;
}

.new-chat {
  color: #333;
}

.topic-home {
  padding: 72rpx 68rpx 0;
}

.intro-title {
  color: #ff3f4d;
  font-weight: 800;
  font-size: 34rpx;
  margin-bottom: 20rpx;
}

.intro-subtitle {
  color: #333;
  font-size: 26rpx;
  margin-bottom: 28rpx;
}

.topic-card {
  height: 104rpx;
  border-radius: 8rpx;
  background: #f8f8f8;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 30rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
}

.topic-left {
  display: flex;
  align-items: center;
  gap: 16rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: #333;
}

.topic-icon,
.active-icon {
  color: #ef3f49;
  font-weight: 800;
}

.topic-arrow {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #fff;
  color: #555;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  line-height: 1;
}

.script-scroll {
  height: calc(100vh - 228rpx);
  padding: 44rpx 38rpx 0;
  box-sizing: border-box;
}

.active-topic {
  height: 104rpx;
  border-radius: 8rpx;
  background: #fafafa;
  display: flex;
  align-items: center;
  gap: 14rpx;
  padding: 0 30rpx;
  color: #ff3f4d;
  font-size: 28rpx;
  font-weight: 800;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.script-title {
  font-size: 30rpx;
  color: #333;
  font-weight: 800;
  margin-bottom: 24rpx;
}

.script-section {
  padding-bottom: 26rpx;
  margin-bottom: 28rpx;
  border-bottom: 1rpx solid #eee;
}

.section-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 800;
  margin-bottom: 16rpx;
}

.section-tips,
.section-script {
  color: #444;
  font-size: 26rpx;
  line-height: 1.55;
}

.section-script {
  margin-top: 8rpx;
}

.text-dock {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 28rpx 24rpx;
  box-sizing: border-box;
}

.text-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 999rpx;
  padding: 0 28rpx;
  color: #333;
  font-size: 24rpx;
  box-sizing: border-box;
}

.send-btn {
  width: 128rpx;
  height: 72rpx;
  line-height: 72rpx;
  padding: 0;
  border-radius: 999rpx;
  background: linear-gradient(90deg, #ff1515, #ff6b00);
  color: #fff;
  font-size: 28rpx;
  font-weight: 800;
}
