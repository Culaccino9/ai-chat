page {
  background: #f6f7fb;
}

.knowledge-page {
  padding: 32rpx 28rpx 140rpx;
}

.home-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 28rpx;
}

.home-title {
  color: #222;
  font-size: 40rpx;
  font-weight: 800;
}

.coach-btn {
  width: 150rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 999rpx;
  padding: 0;
  color: #fff;
  background: linear-gradient(90deg, #ff1515, #ff6b00);
  font-size: 26rpx;
}

.knowledge-card,
.empty-card {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 22rpx;
}

.card-title {
  color: #222;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.35;
  margin-bottom: 14rpx;
}

.card-summary {
  color: #666;
  font-size: 26rpx;
  line-height: 1.5;
  margin-bottom: 18rpx;
}

.card-content {
  color: #333;
  font-size: 28rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.tag-row {
  margin-top: 18rpx;
}

.tag {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #eef2ff;
  color: #1d4ed8;
  font-size: 22rpx;
  margin-right: 10rpx;
}
